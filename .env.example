# =============================================================================
# AI Energy Platform — environment variables (example)
# Copy this file to `.env` and fill in your local values.
# Never commit the real `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string. The database must already exist locally.
# This project does NOT use Docker for PostgreSQL; configure your own local
# instance and create the database before running the seed.
#
# Example:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_energy_platform
DATABASE_URL=postgresql://user:password@localhost:5432/ai_energy_platform

# -----------------------------------------------------------------------------
# AI / LLM provider
# -----------------------------------------------------------------------------
# Default and required for the MVP: stub.
# The stub provider generates deterministic explanations from the structured
# evidence produced by the analytics engine. It does not call any external API.
#
# Possible values:
#   - stub    (default; deterministic, offline)
#   - openai  (optional; only if you also set OPENAI_API_KEY below)
LLM_PROVIDER=stub

# Only required when LLM_PROVIDER=openai. Leave empty otherwise.
# NEVER commit a real key. Set it locally in `.env` (which is gitignored).
OPENAI_API_KEY=
