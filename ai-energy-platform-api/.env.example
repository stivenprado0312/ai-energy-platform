# =============================================================================
# AI Energy Platform — backend (NestJS + Prisma + PostgreSQL) env variables
# Copy this file to `.env` and fill in the values for your local machine.
#
# This file is committed for documentation and contains only placeholders.
# Never commit the real `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string. The user and database must already exist
# locally. The project does NOT use Docker for PostgreSQL.
#
# Replace the placeholders with the credentials of your local PostgreSQL
# instance (see README.md §"Configuring PostgreSQL" for the suggested
# `aiep` / `aiep_dev_password` example).
#
# Example:
#   DATABASE_URL=postgresql://aiep:REPLACE_ME@127.0.0.1:5432/ai_energy_platform
DATABASE_URL=postgresql://user:password@localhost:5432/ai_energy_platform

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port the HTTP server listens on. The frontend expects 3000 by default;
# change here and update NEXT_PUBLIC_API_URL in the frontend .env.local.
PORT=3000

# -----------------------------------------------------------------------------
# AI / LLM provider
# -----------------------------------------------------------------------------
# This project ships with a deterministic StubDeterministicProvider that
# does NOT call any external service. The variable is declared here for
# documentation purposes; the running code currently wires the stub
# directly. Leave LLM_PROVIDER=stub.
#
# Possible future values:
#   - stub    (default; deterministic, offline)
#   - openai  (only when an OpenAI provider implementation is added later)
LLM_PROVIDER=stub

# Only required when LLM_PROVIDER=openai. Leave empty otherwise.
# NEVER commit a real key. Set it locally in `.env` (which is gitignored).
OPENAI_API_KEY=
