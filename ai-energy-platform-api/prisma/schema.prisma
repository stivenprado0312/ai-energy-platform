// Prisma schema for the AI Energy Platform.
// PostgreSQL (local, configured via DATABASE_URL). No Docker.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Meter {
  id        String    @id @default(cuid())
  code      String    @unique
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now()) @map("created_at")
  readings  Reading[]
  events    Event[]

  @@map("meters")
}

model Reading {
  id             BigInt   @id @default(autoincrement())
  meterId        String   @map("meter_id")
  meter          Meter    @relation(fields: [meterId], references: [code], onDelete: Cascade)
  timestamp      DateTime @db.Timestamp(0)
  consumptionKwh Float    @map("consumption_kwh")
  voltageV       Float    @map("voltage_v")
  currentA       Float    @map("current_a")
  powerFactor    Float    @map("power_factor")
  status         String   @default("OK")

  @@unique([meterId, timestamp])
  @@index([meterId, timestamp])
  @@map("readings")
}

model Event {
  id          String   @id @default(cuid())
  meterId     String   @map("meter_id")
  meter       Meter    @relation(fields: [meterId], references: [code], onDelete: Cascade)
  timestamp   DateTime @db.Timestamp(0)
  type        String
  description String

  @@index([meterId, timestamp])
  @@map("events")
}
