# =============================================================================
# AI Energy Platform — frontend (Next.js) environment variables
# Copy this file to `.env.local` and adjust the URL to match where the
# backend is running.
#
# This file is committed for documentation. It contains no secrets.
# Never commit the real `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API base URL
# -----------------------------------------------------------------------------
# The Next.js app calls the NestJS backend directly during page rendering.
#
# Local development (default): the backend listens on http://localhost:3000
# and the frontend on http://localhost:3001. The dev server also exposes a
# Next.js rewrite at /api/* that proxies to the backend (see next.config.js).
#
# Replace with your local backend URL if you use a different host or port.
NEXT_PUBLIC_API_URL=http://localhost:3000
